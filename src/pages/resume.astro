---
// /resume/: the one address that does not boot the desktop. A US Letter sheet in
// the old resume's own design, always light and greyscale, built from the shared
// content (src/lib/resume.ts). The build prints this same page to the PDF
// (scripts/print-resume.ts), so the two never differ.
import ResumeEntry from "../components/ResumeEntry.astro";
import ShareHead from "../components/ShareHead.astro";
import { DESCRIPTION, titleFor } from "../lib/addresses";
import { buildResume, PDF_PATH, PDF_TITLE } from "../lib/resume";
import { RESUME_CARD } from "../lib/share";
import type { Entry } from "../lib/timeline";

const r = buildResume();
const [first = "", ...rest] = r.name.split(" ");
// the degree reads like an entry: years | degree, university; college; concentrations
const degree: Entry = {
  roles: [{ dates: r.education.years, title: r.education.degree }],
  organisation: r.education.university,
  description: r.education.college,
  technologies: r.education.concentrations,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{PDF_TITLE}</title>
    <meta name="description" content={`${r.name}, ${r.title}.`} />
    <ShareHead path="/resume/" title={titleFor("Resume")} description={DESCRIPTION} card={RESUME_CARD} />
    <link rel="preload" href="/fonts/fira-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <nav class="screen-only">
      <a href="/">← shrujancheruku.github.io</a>
      <a class="download" href={PDF_PATH} download>Download PDF</a>
    </nav>

    <main class="sheet">
      <header>
        <div class="who">
          <h1><span>{first}</span><span>{rest.join(" ")}</span></h1>
          <p class="title">{r.title}</p>
        </div>
        <div class="side">
        <ul class="contacts">
          {
            r.contacts.map((c) => (
              <li>
                <i aria-hidden="true">{{ Email: "@", LinkedIn: "in", GitHub: "gh", Site: "www" }[c.label]}</i>
                <a href={c.href}>{c.text}</a>
              </li>
            ))
          }
        </ul>
        <div class="bars" role="list" aria-label="Skills">
        {
          r.bars.map((b) => (
            <div class="bar" role="listitem">
              <span class="name">{b.name}</span>
              <span class="track"><i style={`--len:${b.length}`} /></span>
            </div>
          ))
        }
      </div>

        </div>
      </header>

      <section>
        <h2>Experience</h2>
        {r.entries.map((entry) => <ResumeEntry entry={entry} />)}
      </section>

      <section>
        <h2>Education &amp; Internships</h2>
        <ResumeEntry entry={degree} />
        {r.education.roles.map((entry) => <ResumeEntry entry={entry} />)}
      </section>

      <div class="two">
        <section>
          <h2>Languages</h2>
          <ul class="plain">
            {r.languages.map((l) => <li><b>{l.name}</b> - {l.level}</li>)}
          </ul>
        </section>
        <section>
          <h2>Hobbies</h2>
          <ul class="plain hobbies">
            {r.hobbies.map((h) => <li><b>{h}</b></li>)}
          </ul>
        </section>
      </div>
    </main>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Fira Sans";
    font-weight: 400;
    font-display: block;
    src: url("/fonts/fira-sans-latin-400-normal.woff2") format("woff2");
  }
  @font-face {
    font-family: "Fira Sans";
    font-weight: 700;
    font-display: block;
    src: url("/fonts/fira-sans-latin-700-normal.woff2") format("woff2");
  }
  @font-face {
    font-family: "Fira Mono";
    font-weight: 400;
    font-display: block;
    src: url("/fonts/fira-mono-latin-400-normal.woff2") format("woff2");
  }

  :root {
    color-scheme: light;
    --ink: #000;
    --paper: #fff;
    --desk: #d9d9d9;
    --sans: "Fira Sans", "Helvetica Neue", Arial, sans-serif;
    --mono: "Fira Mono", ui-monospace, Menlo, monospace;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--desk);
    color: var(--ink);
    font: 400 8.4pt/1.38 var(--sans);
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .screen-only {
    width: 8.5in;
    max-width: 100%;
    margin: 18px auto 12px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 13px;
  }
  .screen-only a {
    color: #444;
  }
  .screen-only .download {
    color: var(--paper);
    background: var(--ink);
    padding: 6px 14px;
    text-decoration: none;
    font-weight: 700;
  }

  .sheet {
    width: 8.5in;
    min-height: 11in;
    margin: 0 auto 40px;
    padding: 0.42in 0.55in 0.35in;
    background: var(--paper);
    box-shadow: 0 2px 14px rgb(0 0 0 / 0.25);
  }

  header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2.4em;
    align-items: start;
  }
  h1 {
    font: 800 25pt/1 var(--sans);
    font-weight: 700;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
  h1 span {
    background: var(--ink);
    color: var(--paper);
    padding: 1px 6px 3px;
  }
  .title {
    margin-top: 5px;
    font-size: 12.5pt;
  }
  .contacts {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5pt 1.2em;
    padding-top: 2px;
  }
  .contacts li {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .contacts i {
    flex: none;
    min-width: 17px;
    height: 17px;
    background: var(--ink);
    color: var(--paper);
    font: 700 7pt/17px var(--mono);
    font-style: normal;
    text-align: center;
    padding: 0 2px;
  }
  .contacts a {
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .bars {
    margin: 9pt 0 0;
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 2.5pt 4px;
  }
  .bar {
    display: contents;
  }
  .bar .name {
    justify-self: end;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.86em;
    padding: 0 5px;
    line-height: 1.5;
  }
  .track {
    width: 90.9%;
    height: 0.95em;
  }
  .track i {
    display: block;
    height: 100%;
    width: calc(var(--len) * 100%);
    background: var(--ink);
  }

  section {
    margin-top: 9pt;
  }
  h2 {
    display: inline-block;
    background: var(--ink);
    color: var(--paper);
    font: 700 7pt/1.3 var(--sans);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 1px 6px;
  }

  .two {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    column-gap: 1.5em;
  }
  .plain {
    list-style: none;
    margin-top: 4pt;
  }
  .plain {
    columns: 2;
  }
  .hobbies {
    columns: 3;
  }
  .hobbies li {
    break-inside: avoid;
  }
  .plain b {
    font-weight: 700;
  }

  @page {
    size: Letter;
    margin: 0;
  }
  @media print {
    html,
    body {
      background: var(--paper);
    }
    .screen-only {
      display: none;
    }
    .sheet {
      margin: 0;
      box-shadow: none;
      min-height: 0;
    }
  }

  /* a phone: one column, the header stacked */
  @media (max-width: 720px) {
    .sheet {
      width: 100%;
      min-height: 0;
      margin: 0;
      padding: 18px 16px 28px;
      box-shadow: none;
    }
    body {
      font-size: 10.5pt;
    }
    .screen-only {
      width: 100%;
      padding: 0 16px;
    }
    header {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .contacts,
    .two {
      grid-template-columns: 1fr;
    }
    .bars {
      width: 100%;
    }
        }
</style>
