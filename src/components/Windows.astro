---
// Every window of the desktop. Which are on show, and where, is decided by the
// workspaces' tilings (src/lib/workspaces.ts); this file only holds them.
// Windows other tickets build are placeholders until then.
import { copyOf, stackOf } from "../lib/project-copy";
import type { Project } from "../lib/projects";
import CompositionSlot from "./CompositionSlot.astro";
import NameWindow from "./NameWindow.astro";
import Placeholder from "./Placeholder.astro";
import ProjectCopy from "./ProjectCopy.astro";
import ProjectStack from "./ProjectStack.astro";
import Window from "./Window.astro";

interface Props {
  /** The featured projects, in order: one copy and composition window each. */
  featured: Project[];
  /** How many projects are in the archive. */
  archive: number;
}

const { featured, archive } = Astro.props;
---

<!-- opening, and again on contact -->
<NameWindow />
<Window id="term" label="zsh"><Placeholder ticket={35} /></Window>
<Window id="now" label="~/now"><Placeholder ticket={35} /></Window>

<!-- projects: one step per featured project -->
{
  featured.map((project, i) => (
    <>
      <ProjectCopy n={i + 1} copy={copyOf(project, i + 1, featured.length, archive)} />
      <Window id={`comp-${i + 1}`}>
        <CompositionSlot repository={project.repository} position={i + 1} />
      </Window>
    </>
  ))
}
<ProjectStack stack={stackOf(featured, archive)} />

<!-- timeline -->
<Window id="timeline" label="timeline" scrolls><Placeholder ticket={43} /></Window>
<Window id="education" label="education & internships" scrolls><Placeholder ticket={43} /></Window>
<Window id="skills" label="skills" scrolls><Placeholder ticket={44} /></Window>

<!-- sabbatical -->
<Window id="sabbatical"><Placeholder ticket={45} /></Window>
{[1, 2, 3, 4].map((n) => <Window id={`photo-${n}`}><Placeholder ticket={45} /></Window>)}

<!-- contact -->
<Window id="contact" label="contact — zsh"><Placeholder ticket={46} /></Window>
