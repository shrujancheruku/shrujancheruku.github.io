---
// The place a featured project's composition mounts (#39). It fills the
// window's body, which is a size container, so a composition can use container
// units. The desktop script tells it when its step comes on show and goes:
// it sets `data-active` and fires `composition:enter` / `composition:leave` on
// this element (detail: `{ repository, position }`). Until a composition is
// mounted it holds a placeholder in the site's theme. The composition kit
// (src/compositions/kit.ts) mounts into it, and its styles for the scene, the
// scene unit and the gapped panes are below.
import Placeholder from "./Placeholder.astro";

interface Props {
  repository: string;
  /** 1-based among the featured. */
  position: number;
  /** The ticket that writes this project's composition, for the placeholder. */
  ticket?: number | undefined;
}

const { repository, position, ticket = 39 } = Astro.props;
---

<div
  class="slot"
  data-slot
  data-composition={repository}
  data-position={position}
>
  <p class="who">{repository}</p>
  <Placeholder ticket={ticket} />
</div>

<style>
  .slot {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: color-mix(in srgb, var(--dim) 35%, var(--bg));
    color: var(--fg);
  }

  .who {
    font: 700 clamp(24px, 8cqw, 64px) / 1 var(--title);
    letter-spacing: -0.02em;
    color: var(--ac);
    opacity: 0.35;
  }
</style>

<style is:global>
  /* The scene: fills the slot. `--u` is the scene unit, sized from the window
     (a container): text is 1.3 u, so about 13px in a desktop window and 11px
     on touch. */
  .slot[data-mounted] {
    background: none;
    display: block;
  }

  .scene {
    position: absolute;
    inset: 0;
    --u: clamp(8px, min(1.2cqw, 1.7cqh), 10px);
    font:
      400 calc(1.3 * var(--u)) / 1.56 var(--mono);
    color: var(--fg);
    overflow: hidden;
  }

  @media (max-width: 760px) {
    .scene {
      --u: clamp(7px, 2.4cqw, 8.5px);
    }
  }

  /* A pane: the site's own window, at scene scale. */
  .scene .pn {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: var(--bg);
    border: 2px solid var(--dim);
    border-radius: 14px;
    transition:
      border-color 0.3s,
      background 0.45s;
  }

  .scene .pn.focus {
    border-color: transparent;
    background:
      linear-gradient(var(--bg), var(--bg)) padding-box,
      linear-gradient(135deg, var(--ac), var(--hot)) border-box;
  }

  .scene .lbl {
    position: absolute;
    top: 10px;
    left: 16px;
    font-size: 11px;
    opacity: 0.4;
    pointer-events: none;
  }

  /* typed text's block cursor */
  .scene .cur {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    background: currentColor;
    vertical-align: text-bottom;
    animation: scene-blink 1s steps(1) infinite;
  }

  @keyframes scene-blink {
    50% {
      opacity: 0;
    }
  }
</style>
