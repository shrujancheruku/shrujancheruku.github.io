---
import { Image } from "astro:assets";
// The four photo windows of the sabbatical workspace, a 2 × 2 grid on the right.
// Each slot reads src/content/sabbatical/photos.yaml: a named image from
// src/assets/sabbatical/ goes through Astro's image pipeline, and a slot with no
// file shows its placeholder. Build fails if a slot is missing or names no image.
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import Window from "./Window.astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/sabbatical/*.{avif,jpeg,jpg,png,webp}",
  { eager: true },
);
const byName = new Map(
  Object.entries(images).map(([path, mod]) => [
    path.split("/").pop() ?? path,
    mod.default,
  ]),
);

const photos = await getCollection("sabbatical");
const slots = [1, 2, 3, 4].map((n) => {
  const photo = photos.find((p) => p.data.id === String(n));
  if (!photo)
    throw new Error(`sabbatical photo ${n} is missing from photos.yaml`);
  const { file, place, date } = photo.data;
  let image: ImageMetadata | undefined;
  if (file !== undefined) {
    image = byName.get(file);
    if (!image) throw new Error(`no image ${file} in src/assets/sabbatical/`);
  }
  return { n, place, date, image };
});
---

{
  slots.map(({ n, place, date, image }) => (
    <Window id={`photo-${n}`}>
      {image ? (
        <Image
          src={image}
          alt={place}
          widths={[480, 960]}
          sizes="(max-width: 760px) 100vw, 33vw"
          format="webp"
          quality={78}
          loading="lazy"
          class="img"
        />
      ) : (
        <div class="ph" aria-hidden="true">
          <span>photo {n} · placeholder</span>
        </div>
      )}
      <p class="cap">{place} · {date}</p>
    </Window>
  ))
}

<style>
  :global(.pane[data-window^="photo-"] .body) {
    position: relative;
  }

  .img,
  .ph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .img {
    object-fit: cover;
  }

  /* A placeholder: a diagonal hatch in the theme's accent, set on the background. */
  .ph {
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(
      135deg,
      color-mix(in srgb, var(--ac) 10%, var(--bg)) 0 12px,
      var(--bg) 12px 24px
    );
    font: 11px var(--mono);
    color: color-mix(in srgb, var(--fg) 55%, var(--bg));
  }

  .cap {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 1;
    padding: 6px 14px 6px 12px;
    border-top-right-radius: 8px;
    background: var(--bg);
    font: 12px var(--mono);
    color: var(--fg);
  }
</style>
