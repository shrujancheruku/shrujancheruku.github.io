---
// The name window of the opening workspace: the two-line name.
---

<section class="pane focus" aria-label="name">
  <div class="win">
    <span class="label">~ — shrujan</span>
    <div class="body">
      <div class="name">
        <h1><span>Shrujan</span> <span>Cheruku</span></h1>
        <p class="role">product engineer</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Placed at the opening workspace's tile: left 60%, full height. */
  .pane {
    position: absolute;
    left: 0;
    top: 0;
    width: 60%;
    height: 100%;
    padding: calc(var(--gap) / 2);
  }

  .win {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--bg);
    border: 2px solid var(--dim);
    border-radius: 14px;
  }

  /* the focused window's border: accent to the second colour */
  .focus .win {
    border-color: transparent;
    background:
      linear-gradient(var(--bg), var(--bg)) padding-box,
      linear-gradient(135deg, var(--ac), var(--hot)) border-box;
  }

  .label {
    position: absolute;
    top: 10px;
    left: 16px;
    z-index: 2;
    font: 11px var(--mono);
    opacity: 0.4;
    pointer-events: none;
  }

  .body {
    position: relative;
    flex: 1;
    min-height: 0;
    container-type: size;
  }

  .name {
    position: absolute;
    inset: 0;
    padding: 0 4cqw 0 5cqw;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  h1 {
    font: 700 min(15cqw, 30cqh) / 0.95 var(--title);
    letter-spacing: -0.02em;
  }

  h1 span {
    display: block;
  }

  .role {
    margin-top: 3cqh;
    font: 400 14px var(--mono);
    color: var(--ac);
  }

  .role::before {
    content: "// ";
  }

  @media (max-width: 760px) {
    .pane {
      width: 100%;
      height: 40%;
    }
  }
</style>
