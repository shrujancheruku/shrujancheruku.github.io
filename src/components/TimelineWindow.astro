---
// The timeline: the five career entries, newest first, scrolling inside the
// window on a short screen. On touch nothing scrolls: the entries, and the
// resume download first, are paged over as many screens as they need.
import { PDF_PATH } from "../lib/resume";
import { timeline } from "../lib/timeline";
import TimelineEntry from "./TimelineEntry.astro";
import Window from "./Window.astro";
---

<Window id="timeline" label="timeline" scrolls>
  <div data-paged-root>
    <div class="entries" data-paged>
      <div><a class="dl" href={PDF_PATH} download>↓ resume.pdf</a></div>
      {timeline.map((entry, i) => <TimelineEntry entry={entry} now={i === 0} />)}
    </div>
  </div>
</Window>

<style>
  .dl {
    display: inline-block;
    margin-bottom: 4px;
    padding: 3px 9px;
    border: 1px solid var(--ac);
    border-radius: 9px;
    color: var(--ac);
    font: 500 12px/1.4 var(--mono);
    text-decoration: none;
  }
  .dl:hover,
  .dl:focus-visible {
    background: var(--ac);
    color: var(--bg);
    outline: none;
  }
</style>
