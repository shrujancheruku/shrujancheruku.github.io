---
import "../styles/global.css";
import StatusBar from "../components/StatusBar.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="paper">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ia-writer-duo-latin-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <!-- The bezel: a permanent frame around the screen, CRT effect or not. -->
    <div class="screen">
      <StatusBar />
      <main class="area"><slot /></main>
    </div>
  </body>
</html>

<style>
  .screen {
    position: fixed;
    inset: var(--bz);
    border-radius: var(--br);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--fg);
    /* the dark ring */
    box-shadow:
      0 0 0 2px #000,
      0 0 0 6px #1d1d20;
  }

  .area {
    position: relative;
    flex: 1;
    min-height: 0;
    margin: 0 7px 7px;
  }

  @media (max-width: 760px) {
    .area {
      margin: 0 5px 5px;
    }
  }
</style>
