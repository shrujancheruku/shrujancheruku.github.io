---
import "../styles/global.css";
import StatusBar from "../components/StatusBar.astro";
import Windows from "../components/Windows.astro";
import { createWorkspaces, stepCount } from "../lib/workspaces";

interface Props {
  title: string;
  description: string;
  /** How many featured projects there are: one scroll step each. A placeholder until #37 reads the content. */
  featured?: number;
}

const { title, description, featured = 4 } = Astro.props;
const workspaces = createWorkspaces({ featured });
const steps = stepCount(workspaces);
---

<!doctype html>
<html lang="en" data-theme="paper">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ia-writer-duo-latin-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <!-- The bezel: a permanent frame around the screen, CRT effect or not. -->
    <div class="screen">
      <StatusBar workspaces={workspaces} />
      <main class="area" data-step="0" data-workspace="0">
        <Windows featured={featured} />
        <slot />
      </main>
    </div>
    <!-- On touch the page itself scrolls and snaps, one stop per step. -->
    <div class="snaps" aria-hidden="true">
      {Array.from({ length: steps }, () => <div class="snap" />)}
    </div>
    <script type="application/json" id="desktop-model" set:html={JSON.stringify(workspaces)} />
    <script>
      import "../scripts/desktop";
    </script>
  </body>
</html>

<style>
  .screen {
    position: fixed;
    inset: var(--bz);
    border-radius: var(--br);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--fg);
    /* the dark ring */
    box-shadow:
      0 0 0 2px #000,
      0 0 0 6px #1d1d20;
  }

  .area {
    position: relative;
    flex: 1;
    min-height: 0;
    margin: 0 7px 7px;
  }

  /* Touch: the document scrolls natively, one snap per step; the screen stays fixed. */
  .snaps {
    display: none;
  }

  @media (max-width: 760px) {
    .area {
      margin: 0 5px 5px;
    }

    .snaps {
      display: block;
    }

    .snap {
      height: 100vh;
      height: 100svh;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    :global(html) {
      scroll-snap-type: y mandatory;
    }
  }
</style>
