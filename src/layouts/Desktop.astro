---
import "../styles/global.css";
import NotFoundWindow from "../components/NotFoundWindow.astro";
import ShareHead from "../components/ShareHead.astro";
import StatusBar from "../components/StatusBar.astro";
import Windows from "../components/Windows.astro";
import type { AddressData } from "../lib/addresses";
import { getArchive, getFeatured } from "../lib/projects";
import { cardPathFor } from "../lib/share";
import {
  CRT_KEY,
  DEFAULT_THEME,
  swatch,
  THEME_KEY,
  THEME_NAMES,
  THEMES,
} from "../lib/themes";
import { createWorkspaces, firstStepOf } from "../lib/workspaces";

interface Props {
  title: string;
  description: string;
  /** Every address of the site, for the script to follow (src/lib/addresses.ts). */
  addresses: AddressData;
  /** The step this entry page opens on (default: the first). */
  step?: number;
  /** An unknown path: boot with the not-found terminal. */
  notFound?: boolean;
  /** The address this page is served at, for its share tags. */
  path?: string;
}

const {
  title,
  description,
  addresses,
  step = 0,
  notFound = false,
  path = "/",
} = Astro.props;
const featured = await getFeatured();
const archive = await getArchive();
const card = cardPathFor(
  path,
  featured.map((p) => p.repository),
);
const workspaces = createWorkspaces({
  featured: featured.length,
  archive: archive.length > 0,
});
const themeCss = THEME_NAMES.map(
  (n) =>
    `[data-theme="${n}"]{${[
      ...Object.entries(THEMES[n]).map(([k, v]) => `--${k}:${v}`),
      `--swatch:${swatch(THEMES[n])}`,
    ].join(";")}}`,
).join("");
const themeBoot = { names: THEME_NAMES, themeKey: THEME_KEY, crtKey: CRT_KEY };
const workspacePaths = workspaces.map(
  (_, i) => addresses.byStep[firstStepOf(workspaces, i)] ?? "/",
);
---

<!doctype html>
<html lang="en" data-theme={DEFAULT_THEME} data-crt="on">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <style is:global set:html={themeCss} />
    <!-- before first paint: the remembered theme and crt choice, paper and on if there is none -->
    <script is:inline define:vars={{ boot: themeBoot }}>
      try {
        const t = localStorage.getItem(boot.themeKey);
        if (t && boot.names.includes(t)) document.documentElement.dataset.theme = t;
        if (localStorage.getItem(boot.crtKey) === "off") document.documentElement.dataset.crt = "off";
      } catch {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <ShareHead path={path} title={title} description={description} card={card} />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ia-writer-duo-latin-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="idle">
    <!-- The bezel: a permanent frame around the screen, CRT effect or not. -->
    <div class="screen">
      <StatusBar workspaces={workspaces} />
      <main class="area" data-step={step} data-workspace="0" data-boot-step={step} data-not-found={notFound ? "true" : undefined}>
        <Windows featured={featured} archive={archive} />
        {notFound && <NotFoundWindow workspaces={workspaces} paths={workspacePaths} />}
        <slot />
      </main>
      <!-- The crt effect's overlay: never takes clicks, selection or scrolling. -->
      <canvas id="crt-canvas" aria-hidden="true"></canvas>
    </div>
    <script type="application/json" id="desktop-addresses" set:html={JSON.stringify(addresses)} />
    <script type="application/json" id="desktop-model" set:html={JSON.stringify(workspaces)} />
    <script>
      import "../scripts/desktop";
      import "../scripts/chrome";
      import "../scripts/crt";
      import "../scripts/compositions";
    </script>
  </body>
</html>

<style>
  .screen {
    position: fixed;
    inset: var(--bz);
    border-radius: var(--br);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--fg);
    /* the dark ring */
    box-shadow:
      0 0 0 2px #000,
      0 0 0 6px #1d1d20;
  }

  #crt-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 50;
    pointer-events: none;
    mix-blend-mode: multiply;
    display: none;
  }

  /* crt effect on: the overlay, the glass, the accent glow and the text glow. The bezel is the same either way. */
  :global(html[data-crt="on"]) #crt-canvas {
    display: block;
  }

  :global(html[data-crt="on"]) .screen {
    text-shadow: 0 0 0.45em color-mix(in srgb, currentColor 40%, transparent);
    box-shadow:
      0 0 0 2px #000,
      0 0 0 6px #1d1d20,
      0 0 40px 6px color-mix(in srgb, var(--ac) 14%, transparent);
  }

  :global(html[data-crt="on"]) .screen::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 55;
    box-shadow:
      inset 0 0 28px 0 #0004,
      inset 0 0 0 2px #0007;
    background: linear-gradient(160deg, #ffffff0d, transparent 38%);
  }

  .area {
    position: relative;
    flex: 1;
    min-height: 0;
    margin: 0 7px 7px;
  }

  /* Touch: the page never scrolls; a swipe is one step (src/lib/swipe.ts).
     Pinch-zoom stays the browser's, and on a zoomed-in page one finger pans. */
  @media (max-width: 760px) {
    .area {
      margin: 0 5px 5px;
    }

    :global(html),
    :global(body) {
      overscroll-behavior: none;
      touch-action: pinch-zoom;
    }

    :global(html[data-zoomed="true"]),
    :global(html[data-zoomed="true"] body) {
      touch-action: manipulation;
    }
  }
</style>
